account_id             = "123456789012"
region                 = "us-east-2"
deployment             = "personal-dev"
owner                  = "replace-me"
operator_principal_arn = "arn:aws:iam::123456789012:role/ExistingLoginRole"
ami_id                 = "ami-00000000000000000" # Resolve using docs/setup.md, never apply this fixture.

# Replace with your dedicated Ed25519 public key (first two fields, no comment).
ssh_public_key = "ssh-ed25519 REPLACE_WITH_PUBLIC_KEY_BASE64"

# Build with make runner from the checkout root before planning.
runner_path           = "../../bin/devbox-runner-linux-amd64"
result_retention_days = 30 # Whole days, 2-365; never shorten unexpired promises.

# Adding b/c preserves the original a subnet and its CIDR/resource address.
availability_zones = ["us-east-2a", "us-east-2b", "us-east-2c"]
instance_types     = ["c7i.2xlarge", "c7a.2xlarge", "c6i.2xlarge", "c6a.2xlarge"]
root_disk_gb       = 100 # Encrypted gp3, deleted on termination; must fit the AMI.
